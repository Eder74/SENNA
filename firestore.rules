rules_version = '2';
// S.E.N.N.A. · regras de acesso do Firestore
// Ninguém lê dado de módulo sem estar logado E aprovado pelo moderador.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function eu() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function aprovado() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && eu().status == 'aprovado';
    }
    function papel(lista) { return aprovado() && eu().papel in lista; }

    // Cadastro de usuários: cada pessoa só cria o próprio pedido, sempre como pendente/leitura.
    match /usuarios/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || aprovado();
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'status', 'papel', 'criadoEm'])
        && request.resource.data.status == 'pendente' && request.resource.data.papel == 'leitor';
      allow update, delete: if papel(['moderador']);
    }

    // Dados dos módulos: aprovados leem; piloto e moderador gravam.
    match /modulos/{modulo}/{resto=**} {
      allow read: if aprovado();
      allow write: if papel(['piloto', 'moderador']);
    }
    // Avaliações 👍/👎 do Beto e da Bety: qualquer aprovado registra.
    match /modulos/{modulo}/aprendizado/{id} {
      allow create, update: if aprovado();
    }

    // Bases grandes que antes vinham embutidas no HTML.
    match /embutidos/{resto=**} {
      allow read: if aprovado();
      allow write: if papel(['moderador']);
    }
  }
}
